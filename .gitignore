# Секреты — НИКОГДА не должны попасть в историю.
# Здесь лежит отпечаток пароля и ключ подписи сессий.
data/auth.json
data/web_key.json

# Скачивается и пересобирается само при запуске refresh.bat,
# поэтому в истории хранить незачем.
data/season.json
data/site_data.json
data/memorial.json
data/club_games.json
data/club_news.json
data/club_history.json
data/league_faces.json
web/vendor/
web/logos/
web/photos/

# Собирается из web/shell.html при каждом запуске
web/index.html
web/logos.css
publish/

# Служебное
__pycache__/
*.pyc
*.log

# data/claude_picks.json тоже хранится в истории: прогноз Claude на матч
# замораживается в момент начала игры, и облачное обновление берёт
# сделанные раньше прогнозы из репозитория.

# data/injuries.json НЕ игнорируется намеренно: там твои ручные отметки
# о травмах, и их стоит хранить в истории как обычный текст.

